rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Restaurants: Anyone can read, authenticated kitchen owners can create/update
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Dishes / Menu Items: Anyone can read, authenticated kitchens can create/update
    match /dishes/{dishId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders: Anyone authenticated can create an order, update status, and read orders
    match /orders/{orderId} {
      allow read, write: if true; // In development / test mode; configure per-user in production
    }

    // Users collection: Read and write own profile
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
  }
}
